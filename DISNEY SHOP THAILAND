    }


    cartItems.innerHTML =
        cart.map(
            (movie, index) => `

                <div class="cart-row">

                    <img
                        src="${movie.img}"
                        alt="${movie.title}"
                    >

                    <div class="cart-row-info">

                        <strong>
                            ${movie.title}
                        </strong>

                        <div>
                            ${movie.thai}
                        </div>

                        <small>
                            ${movie.year}
                            • ${movie.studio}
                        </small>

                    </div>

                    <button
                        class="remove-cart"
                        onclick="
                            removeFromCart(${index})
                        "
                    >
                        ลบ
                    </button>

                </div>

            `
        )
        .join("");

}


/* =========================================================
   REMOVE CART
========================================================= */

function removeFromCart(index) {

    cart.splice(
        index,
        1
    );

    updateCart();

}


