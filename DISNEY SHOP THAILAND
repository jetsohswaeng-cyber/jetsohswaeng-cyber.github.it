    padding:
        12px;

    background:
        #eef4ff;

    color:
        var(--blue);

    border-radius:
        12px;

    margin:
        12px 0;

}


.modal-actions {

    display:
        flex;

    gap:
        10px;

    flex-wrap:
        wrap;

    margin-top:
        20px;

}


.modal-actions a,
.modal-actions button {

    border:
        0;

    border-radius:
        999px;

    padding:
        11px 18px;

    font-weight:
        600;

}


.modal-actions .youtube {

    background:
        #e31b23;

    color:
        white;

}


.modal-actions .cart {

    background:
        var(--gold);

    color:
        #15203a;

}


/* =========================================================
   CART
========================================================= */

.cart-box {

    padding:
        30px;

}


.cart-box h2 {

    color:
        var(--blue-dark);

    margin-bottom:
        20px;

}


.cart-row {

    display:
        flex;

    align-items:
        center;

    gap:
        12px;

    padding:
        12px 0;

    border-bottom:
        1px solid
        #e7ebf2;

}


.cart-row img {

    width:
        55px;

    height:
        75px;

    object-fit:
        cover;

    border-radius:
        8px;

}


.cart-row-info {

    flex:
        1;

}


.remove-cart {

    border:
        0;

    background:
        #ffe8e8;

    color:
        #b52d2d;

    padding:
        7px 10px;

    border-radius:
        8px;

}


.cart-total {

    margin-top:
        20px;

    text-align:
        right;

    font-size:
        18px;

}


/* =========================================================
   EMPTY
========================================================= */

.empty-result {

    grid-column:
        1 / -1;

    padding:
        80px 20px;

    text-align:
        center;

    background:
        white;

    border-radius:
        20px;

    color:
        var(--text-gray);

}


.empty-result strong {

    display:
        block;

    font-size:
        45px;

    color:
        var(--blue);

    margin-bottom:
        10px;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1200px) {

    .movie-grid {
        grid-template-columns:
            repeat(4, 1fr);
    }

}


@media (max-width: 900px) {

    .main-nav {
        display: none;
    }

    .movie-grid {
        grid-template-columns:
            repeat(3, 1fr);
    }

    .control-panel {
        grid-template-columns:
            1fr 1fr;
    }

    .search-box {
        grid-column:
            1 / -1;
    }

    .stats-section {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 650px) {

    .movie-grid {
        grid-template-columns:
            repeat(2, 1fr);

        gap: 12px;
    }

    .movie-body {
        padding: 11px;
    }

    .movie-title {
        font-size: 14px;
    }

    .movie-th {
        font-size: 10px;
    }

    .movie-actions {
        grid-template-columns:
            1fr;
    }

    .control-panel {
        grid-template-columns:
            1fr;
    }

    .search-box {
        grid-column:
            auto;
    }

    .stats-section {
        grid-template-columns:
            1fr 1fr;

        margin-top:
            -35px;
    }

    .modal-movie {
        grid-template-columns:
            1fr;

        padding:
            22px;
    }

    .modal-poster {
        max-width:
            240px;

        margin:
            auto;
    }

    .about-card {
        grid-template-columns:
            1fr;

        text-align:
            center;
    }

    .about-logo {
        margin:
            auto;
    }

}


@media (max-width: 420px) {

    .movie-grid {
        grid-template-columns:
            1fr 1fr;
    }

    .brand-subtitle {
        display:
            none;
    }

    .brand-title {
        font-size:
            12px;
    }

    .cart-button span {
        display:
            none;
    }

} 
