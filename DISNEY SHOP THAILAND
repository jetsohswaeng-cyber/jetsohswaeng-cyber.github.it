/* =========================================================
   FORMAT DATE
========================================================= */

function formatDate(dateString) {

    if (!dateString ||
        dateString === "ไม่พบข้อมูลวันฉายไทยที่ยืนยันได้") {

        return dateString;
    }

    const date = new Date(dateString + "T00:00:00");

    if (Number.isNaN(date.getTime())) {
        return dateString;
    }

    return date.toLocaleDateString(
        "th-TH",
        {
            day:"numeric",
            month:"long",
            year:"numeric"
        }
    );
}


/* =========================================================
   DECADE
========================================================= */

function getDecade(year) {

    return Math.floor(year / 10) * 10;

}


/* =========================================================
   STAR DISPLAY
========================================================= */

function getStars(score) {

    const normalized =
        Math.max(
            0,
            Math.min(
                5,
                score / 2
            )
        );

    const full =
        Math.floor(normalized);

    const half =
        normalized - full >= .5 ? 1 : 0;

    let result = "";

    for (let i = 0; i < full; i++) {
        result += "★";
    }

    if (half) {
        result += "½";
    }

    while (result.length < 5) {
        result += "☆";
    }

    return result;
}


/* =========================================================
   RENDER MOVIES
========================================================= */

function renderMovies() {

    const search =
        searchInput.value
            .trim()
            .toLowerCase();

    const studio =
        studioFilter.value;

    const decade =
        decadeFilter.value;

    const sort =
        sortFilter.value;


    let filtered =
        movies.filter(movie => {

            const matchSearch =
                movie.title
                    .toLowerCase()
                    .includes(search)
                ||
                movie.thai
                    .toLowerCase()
                    .includes(search);

            const matchStudio =
                studio === "all"
                ||
                movie.studio === studio;

            const matchDecade =
                decade === "all"
                ||
                getDecade(movie.year)
                    .toString()
                    === decade;

            return (
                matchSearch &&
                matchStudio &&
                matchDecade
            );

        });


    /* SORT */

    if (sort === "yearAsc") {

        filtered.sort(
            (a,b) => a.year - b.year
        );

    }

    if (sort === "yearDesc") {

        filtered.sort(
            (a,b) => b.year - a.year
        );

    }

    if (sort === "ratingDesc") {

        filtered.sort(
            (a,b) => b.imdb - a.imdb
        );

    }

    if (sort === "title") {

        filtered.sort(
            (a,b) =>
                a.title.localeCompare(
                    b.title
                )
        );

    }


    resultCount.textContent =
        filtered.length;


    movieGrid.innerHTML = "";


    if (!filtered.length) {

        movieGrid.innerHTML = `

            <div class="empty-result">

                <strong>🔎</strong>

                <h3>
                    ไม่พบภาพยนตร์
                </h3>

                <p>
                    ลองเปลี่ยนคำค้นหาหรือ
                    ตัวกรองภาพยนตร์
                </p>

            </div>

        `;

        return;
    }


    filtered.forEach(
        movie => {

            movieGrid.insertAdjacentHTML(
                "beforeend",
                createMovieCard(movie)
            );

        }
    );

}


