function addToCart(title) {

    const movie =
        movies.find(
            item => item.title === title
        );

    if (!movie) {
        return;
    }


    const exists =
        cart.some(
            item =>
                item.title === movie.title
        );


    if (!exists) {

        cart.push(movie);

    }


    updateCart();


    movieModal.classList.add(
        "hidden"
    );

}


